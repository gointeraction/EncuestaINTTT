// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Respuesta completa de una encuesta
model SurveyResponse {
  id          String   @id @default(cuid())
  driverType  String   // DriverTypeId
  // Las respuestas se guardan como JSON: { questionId: value }
  answers     String   // JSON string
  completedAt DateTime @default(now())

  // Datos personales para el sorteo (opcionales — solo si participa)
  participaSorteo Boolean @default(false)
  nombre          String?
  cedula          String? // formato: V-12345678 o E-12345678
  telefono        String? // formato: +58 412-1234567
  // Hash del número de confirmación para el sorteo
  codigoSorteo    String?

  @@index([driverType])
  @@index([completedAt])
  @@index([participaSorteo])
  @@index([cedula])
}

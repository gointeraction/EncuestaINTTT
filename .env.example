# =============================================================================
# EncuestaINTTT — plantilla de configuración para `docker compose`.
# Copia este archivo a `.env` y ajusta los valores:
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL (host interno `db`; la app lo resuelve por DATABASE_URL) ---
POSTGRES_USER=intt_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=intt_encuesta

# --- Panel de administración privado ---
ADMIN_PASSWORD=change_me_admin_password
# Genera uno con: openssl rand -hex 32
ADMIN_SECRET=change_me_64_hex_chars

# --- Cloudflare Turnstile (anti-bot) ---
# Claves de PRUEBA (siempre pasan). Reemplaza por las reales de producción.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# La site key se INLINEA en el cliente en tiempo de BUILD (prefijo NEXT_PUBLIC_).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- URL pública (se INLINEA en el build; se usa para QR/enlaces) ---
NEXT_PUBLIC_APP_URL=https://encuesta.intt.gob.ve

# --- Opcionales del despliegue ---
# Esquema: push (default, crea todo) o deploy (migraciones ya baselinadas)
# DB_SYNC=push
# Importar respaldo histórico una vez: db/sqlite_backup.json
# IMPORT_BACKUP=0
# Precalcular el dashboard una vez al arrancar
# SUMMARIZE=0
# Puerto HTTP del proxy perimetral
# HTTP_PORT=80

# =============================================================================
# EncuestaINTTT — plantilla de entorno.  Copia este archivo a .env.development
# y/o .env.production y rellena los valores (los .env* NO se versionan).
#
#   dev :  cp .env.example .env.development && docker compose --env-file .env.development up -d --build
#   prod:  cp .env.example .env.production  && docker compose --env-file .env.production  up -d --build
#
# Ver .akuri/00-manifest/environments.md (dos entornos aislados).
# =============================================================================

# --- Entorno (define base de datos, ruta de datos y proyecto de compose) ---
# development → POSTGRES_DB=intt_encuesta_dev, datos en ./.data/development/
# production  → POSTGRES_DB=intt_encuesta,     datos en ./.data/production/
APP_ENV=development
COMPOSE_PROJECT_NAME=encuesta-intt-dev
# Solo development: habilita el seeder destructivo (analytics/seed). En prod, OMITIR.
SEED_ALLOW=1

# --- PostgreSQL ---
POSTGRES_USER=intt_user
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=intt_encuesta_dev
# URL de la captura (host, para scripts locales; los contenedores usan el host interno `db`)
DATABASE_URL=postgresql://intt_user:cambia-esta-clave@localhost:5451/intt_encuesta_dev?schema=public
# Rol del back-office analítico (esquema `analytics`, SELECT sobre `public`)
ANALYTICS_DB_PASSWORD=cambia-esta-clave

# --- Admin de staff (el migrate lo siembra al crear el esquema) ---
STAFF_ADMIN_EMAIL=admin@intt.gob.ve
STAFF_ADMIN_PASSWORD=StaffAdmin2026!

# --- Panel de administración privado (captura) ---
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_SECRET=cambia-este-secreto

# --- Cloudflare Turnstile (claves de prueba siempre-pasan) ---
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- URL pública (build-time) ---
NEXT_PUBLIC_APP_URL=https://encuesta.intt.gob.ve

# --- Puertos host (opcional) ---
# HTTP_PORT=80
# ADMIN_PORT=4301

# --- Seeder (opcional): UID/GID del host para que los CSV salgan con tu usuario ---
# HOST_UID=1000
# HOST_GID=1000

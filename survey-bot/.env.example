# ============================================================================
# survey-bot — configuración (todas opcionales; hay valores por defecto)
# ============================================================================

# URL de la captura (Visión Cero). Local docker: http://localhost:80
# En Docker (contenedor): http://host.docker.internal:80
BASE_URL=http://localhost:80

# Perfil de conductor a elegir (texto visible del botón/card).
DRIVER_TYPE=Motociclista activo

# Cuántas encuestas enviar y cuántas en paralelo.
COUNT=1
CONCURRENCY=1

# Pausa entre interacciones (ms), para simular a un humano.
THINK_MS=400

# true por defecto. Pon false para VER el navegador.
HEADLESS=true

# Participar en el sorteo (rellena nombre/cédula/teléfono). Por defecto NO.
PARTICIPATE=false

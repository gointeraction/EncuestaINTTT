# =============================================================================
# deploy/intt/env/produccion.env.example — Plantilla de entorno PRODUCCIÓN.
# Copiar a `.env.production` en la raíz del repo y REEMPLAZAR todo CAMBIA_*.
# Rama que despliega: `produccion` (PROTEGIDA) · APP_ENV=production · BD intt_encuesta.
#   cp deploy/intt/env/produccion.env.example .env.production && chmod 600 .env.production
#
# PROHIBIDO en producción: SEED_ALLOW, el servicio `seed`, claves Turnstile de prueba.
# =============================================================================

# --- Entorno ---
APP_ENV=production
COMPOSE_PROJECT_NAME=encuesta-intt-prod
POSTGRES_DB=intt_encuesta

# --- PostgreSQL ---
POSTGRES_USER=intt_user
POSTGRES_PASSWORD=CAMBIA_CLAVE_BD_FUERTE
ANALYTICS_DB_PASSWORD=CAMBIA_CLAVE_ANALYTICS_FUERTE
# Ruta ABSOLUTA en la VM-DATABASE (o donde corra la base).
PG_DATA_DIR=/var/lib/encuesta-intt/production/postgres

# --- Staff / consola analítica (cambiar el default; nunca el de ejemplo) ---
STAFF_ADMIN_EMAIL=admin@intt.gob.ve
STAFF_ADMIN_PASSWORD=CAMBIA_CLAVE_STAFF_FUERTE

# --- Panel privado de la captura ---
ADMIN_PASSWORD=CAMBIA_CLAVE_ADMIN_FUERTE
ADMIN_SECRET=CAMBIA_SECRETO_ADMIN_FUERTE

# --- Cloudflare Turnstile (CLAVES REALES de producción) ---
TURNSTILE_SITE_KEY=CAMBIA_SITE_KEY_REAL
TURNSTILE_SECRET_KEY=CAMBIA_SECRET_KEY_REAL
NEXT_PUBLIC_TURNSTILE_SITE_KEY=CAMBIA_SITE_KEY_REAL

# --- URL pública (se incrusta en BUILD; cambiarla exige reconstruir app/proxy) ---
NEXT_PUBLIC_APP_URL=https://encuesta.intt.gob.ve

# --- Puertos host ---
HTTP_PORT=80
# Consola analítica (PRIVADA): la IP LAN de la intranet, nunca 0.0.0.0.
ADMIN_BIND=127.0.0.1
ADMIN_PORT=4301

# --- Secreto del canal `seed` (fuerte; protege el reenvío del seeder) ---
SEED_SUBMIT_SECRET=CAMBIA_SECRETO_SEED_FUERTE

# =============================================================================
# Despliegue PARTIDO (roles webapp / database / lb). Sustituir por IPs reales.
# =============================================================================
DB_HOST=10.10.0.11
DB_PORT=5451
REDIS_HOST=10.10.0.11
REDIS_PORT=6379
APP01=10.10.0.21:3001
APP02=10.10.0.22:3001

# =============================================================================
# deploy/intt/env/qa.env.example — Plantilla de entorno QUALITY ASSURANCE (QA).
# Copiar a `.env.qa` en la raíz del repo y REEMPLAZAR todo lo marcado CAMBIA_*.
# Rama que despliega: `calidad`  ·  APP_ENV=qa  ·  base de datos intt_encuesta_qa.
#   cp deploy/intt/env/qa.env.example .env.qa && chmod 600 .env.qa
# =============================================================================

# --- Entorno (define base de datos, ruta de datos y proyecto de compose) ---
APP_ENV=qa
COMPOSE_PROJECT_NAME=encuesta-intt-qa
POSTGRES_DB=intt_encuesta_qa
# El seeder NO aplica en QA (sólo `development`); NO definir SEED_ALLOW.

# --- PostgreSQL ---
POSTGRES_USER=intt_user
POSTGRES_PASSWORD=CAMBIA_CLAVE_BD
# Rol del back-office analítico (esquema analytics)
ANALYTICS_DB_PASSWORD=CAMBIA_CLAVE_ANALYTICS
# Ruta (host) donde PostgreSQL guarda la data (bind mount del servicio db).
# Escenario 2 VMs / 5 VMs: ruta ABSOLUTA en la VM-DATABASE.
PG_DATA_DIR=/var/lib/encuesta-intt/qa/postgres

# --- Staff / consola analítica ---
STAFF_ADMIN_EMAIL=admin@intt.gob.ve
STAFF_ADMIN_PASSWORD=CAMBIA_CLAVE_STAFF

# --- Panel privado de la captura ---
ADMIN_PASSWORD=CAMBIA_CLAVE_ADMIN
ADMIN_SECRET=CAMBIA_SECRETO_ADMIN

# --- Cloudflare Turnstile (QA usa las claves de prueba que siempre pasan) ---
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- URL pública (se incrusta en BUILD; cambiarla exige reconstruir app/proxy) ---
NEXT_PUBLIC_APP_URL=http://qa.encuesta.intt.gob.ve

# --- Puertos host ---
HTTP_PORT=80
# Consola analítica (PRIVADA): enlazar sólo a la interfaz interna, nunca 0.0.0.0.
ADMIN_BIND=127.0.0.1
ADMIN_PORT=4301

# --- Secreto del canal `seed` (un valor fuerte, distinto de dev) ---
SEED_SUBMIT_SECRET=CAMBIA_SECRETO_SEED

# =============================================================================
# Despliegue PARTIDO (roles webapp / database / lb). En un solo host, ignorar.
# Sustituir por las IPs reales de las VMs del cliente.
# =============================================================================
# VM-DATABASE (PostgreSQL + Redis)
DB_HOST=10.10.0.11
DB_PORT=5451
REDIS_HOST=10.10.0.11
REDIS_PORT=6379
# VMs de aplicación (upstream del balanceador, formato IP:puerto)
APP01=10.10.0.21:3001
APP02=10.10.0.22:3001
